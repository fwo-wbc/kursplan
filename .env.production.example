# ============================================================
# .env.production.example – Kursplan-App (Vorlage für Produktion)
#
# Vorgehen:
#   1. Diese Datei nach ".env.production" kopieren
#      (cp .env.production.example .env.production)
#   2. Alle CHANGE_ME-Werte ersetzen
#   3. Datei NIEMALS committen – .gitignore schließt .env.production aus
#
# Alle Werte werden erst beim Container-Start (Laufzeit) gelesen
# und landen daher nicht im Docker-Image.
# ============================================================

# ---------- Basic Auth (Middleware) ----------
# Zugangsdaten für den Basic-Auth-Schutz der gesamten App (ein Admin).
# Werte MÜSSEN gesetzt sein, sonst wird jeder Request mit 401 abgelehnt.
ADMIN_USER=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# ---------- Trainerportal (Portal-Login) ----------
# Secret für die HMAC-Signatur des Session-Cookies 'trainer_session'.
# Absolut zwingend ändern (mind. 32 Zeichen, z. B. openssl rand -hex 32).
SESSION_SECRET=CHANGE_ME_TRAINER_PORTAL_SECRET
# 'Secure'-Flag für das Trainer-Session-Cookie: nur bei HTTPS-Betrieb auf true
# setzen (z. B. hinter Reverse-Proxy mit TLS). Bei reinem HTTP-Zugriff false
# lassen, sonst verwirft der Browser das Cookie.
COOKIE_SECURE=false

# ---------- E-Mail-Versand (Passwort-Reset) ----------
# Versand über die Microsoft Graph API (OAuth2 Client Credentials Flow).
# Ohne diese Werte wird der Versand übersprungen (kein Crash).
AZURE_TENANT_ID=CHANGE_ME
AZURE_CLIENT_ID=CHANGE_ME
AZURE_CLIENT_SECRET=CHANGE_ME
# Technisches Postfach, über das der Versand über die Graph-API läuft
AZURE_SENDER_MAIL=frank.woltmann@webinarcenter.de
# Sichtbare Absenderadresse (From) – Standard: admin@webinarcenter.de
AZURE_FROM_MAIL=admin@webinarcenter.de
# Öffentliche Basis-URL der App für den Reset-Link
BASE_URL=http://46.62.206.211:3000

# ---------- PostgreSQL ----------
# Bevorzugt: vollständiger Connection-String.
DATABASE_URL=postgresql://app_user:CHANGE_ME@db-server.intern:5433/kursplan

# Alternativ in Einzelteilen (wird nur genutzt, wenn DATABASE_URL leer ist):
# DB_HOST=db-server.intern
# DB_PORT=5433
# DB_NAME=kursplan
# DB_USER=app_user
# DB_PASSWORD=CHANGE_ME

# ---------- n8n-Integration (Webhooks / Rückkanäle) ----------
# Event-Notifications bei Termin-Änderungen (Terminstatus, Trainer, Zeit)
N8N_NOTIFICATION_WEBHOOK_URL=https://n8n.webinarcenter.de/webhook/termin-event
# P06: Trainer-Ad-hoc-Sync
N8N_TRAINER_SYNC_WEBHOOK_URL=https://n8n.example.de/webhook/sync-trainer
# Gemeinsames Secret für den Header "X-Sync-Token" (absolut zwingend ändern)
N8N_SYNC_SECRET=CHANGE_ME

# P06: Trainerzuweisung -> edoobox
N8N_WEBHOOK_URL_TRAINER_SYNC=https://n8n.example.de/webhook/sync-trainer-to-edoobox

# P90: Ressourcen-Sync (Sync-Button im Header)
N8N_P90_WEBHOOK_URL=https://n8n.example.de/webhook/p90-sync

# L-05: Termin-Übertragung an edoobox (Serienplaner)
N8N_EDOOBOX_WEBHOOK_URL=https://n8n.example.de/webhook/sync-pending-events

# Weitere n8n-Rückkanäle (Trainer-Update, Angebotserstellung)
N8N_WEBHOOK_URL=https://n8n.example.de/webhook
N8N_WEBHOOK_URL_CREATE_OFFER=https://n8n.example.de/webhook/create-edoobox-offer

# ---------- edoobox (Cleanup-API "gelöschte Kurse") ----------
EDOOBOX_API_BASE=https://app1.edoobox.com
EDOOBOX_EDID=CHANGE_ME
EDOOBOX_USER=CHANGE_ME
EDOOBOX_PASSWORD=CHANGE_ME
