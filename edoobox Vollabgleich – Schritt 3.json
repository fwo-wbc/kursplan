      "id": "f4962864-c25f-4e8c-bde7-1fc971cd9457",
      "name": "Kurzlebigen edoobox-Token holen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "function beschreibe(wert, schluessel = '') {\n  if (/token|secret|authorization|cookie/i.test(schluessel)) {\n    return '[ausgeblendet]';\n  }\n  if (Array.isArray(wert)) {\n    return {\n      typ: 'array',\n      anzahl: wert.length,\n      erstes_element: wert.length ? beschreibe(wert[0]) : null,\n    };\n  }\n  if (wert !== null && typeof wert === 'object') {\n    return Object.fromEntries(\n      Object.entries(wert).map(([k, v]) => [k, beschreibe(v, k)])\n    );\n  }\n  return { typ: wert === null ? 'null' : typeof wert };\n}\n\nreturn [{\n  json: {\n    hinweis: 'Nur Feldnamen und Datentypen; Zugangswerte wurden ausgeblendet.',\n    antwortstruktur: beschreibe($input.first().json),\n    run_id: $('Vollabgleich starten').first().json.run_id\n  }\n}];"
      },
