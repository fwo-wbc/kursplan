        "operation": "executeQuery",
        "query": "WITH vorherige_laeufe AS (\n    UPDATE edoobox_raw.sync_run\n    SET\n        status = 'abgebrochen',\n        finished_at = now(),\n        error_text = 'Durch neuen manuellen Vollabgleich ersetzt'\n    WHERE run_type = 'vollabgleich'\n      AND status = 'laeuft'\n)\nINSERT INTO edoobox_raw.sync_run (\n    run_type,\n    status\n)\nVALUES (\n    'vollabgleich',\n    'laeuft'\n)\nRETURNING\n    run_id,\n    started_at,\n    status;",
        "options": {}
      },
