    {
      "parameters": {
        "jsCode": "const authItem = $input.first().json;\nlet webhookData = $('Webhook').first().json.body || {};\n\nif (typeof webhookData === 'string') {\n  try { webhookData = JSON.parse(webhookData); } catch(e) {}\n}\n\nlet authBody = authItem.body || authItem;\nif (typeof authBody === 'string') {\n  try { authBody = JSON.parse(authBody); } catch (e) { authBody = {}; }\n}\n\nconst token = authBody.token || authBody.access_token || (authBody.data && authBody.data.token) || authItem.token;\nconst edid = authBody.edid || (authBody.data && authBody.data.edid) || (authItem.headers && authItem.headers.edid);\n\nif (!token) throw new Error('Kein Token in der Antwort von edoobox Auth1 gefunden.');\n\nconst kurse = webhookData.kurse || [];\n\nif (kurse.length === 0) {\n  if (webhookData.name) {\n    kurse.push(webhookData);\n  } else {\n    throw new Error('Es wurden keine Kurse gefunden!');\n  }\n}\n\n// Wir reichen die vom Dashboard vorbereitete Nummer direkt sauber an edoobox weiter\nreturn kurse.map(kurs => ({\n  json: {\n    ...kurs,\n    number: kurs.number, // Nutzt exakt die Nummer aus dem Dashboard (inkl. -MMYY-X)\n    token: token,\n    edid: edid || '6aca451c89c867O0O22475357ce9a0318e614f7537d76e12ff1fcf1bf'\n  }\n}));"
      },
