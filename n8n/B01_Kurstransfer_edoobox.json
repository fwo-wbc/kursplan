    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst config = $('Auth & Konfiguration aufbereiten').item.json;\n\nconst newId = (response.data && response.data.id) || response.id;\n\nif (!newId) {\n  throw new Error('Keine neue Angebots-ID in der Antwort von edoobox gefunden.');\n}\n\nreturn [\n  {\n    json: {\n      success: response.success,\n      new_offer_id: newId,\n      basis: config.basis,\n      category: config.category,\n      number: config.number,\n      name: config.name,\n      token: config.token,\n      edid: config.edid,\n      kurs_key: config.kurs_key,\n      datum: config.datum,\n      beginn: config.beginn,\n      kursCode: config.kursCode,\n      raw_response: response\n    }\n  }\n];"
