    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO kurstransfer_status (kurs_key, status, updated_at)\nVALUES \n{{ $json.batchKurse.map(k => \"('\" + k.kurs_key + \"', 'erledigt', NOW())\").join(', ') }}\nON CONFLICT (kurs_key) \nDO UPDATE SET \n    status = 'erledigt',\n    updated_at = NOW();",
        "options": {}
      },
