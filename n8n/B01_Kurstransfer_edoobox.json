    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst prev = $('ID extrahieren & normalisieren').item.json;\n\nlet textId = null;\n\nif (response && response.data && typeof response.data === 'object' && !Array.isArray(response.data)) {\n  const keys = Object.keys(response.data);\n  if (keys.length > 0) {\n    textId = keys[0]; \n  }\n} else if (response && Array.isArray(response.data)) {\n  if (response.data.length > 0) {\n    textId = response.data[0].id;\n  }\n} else if (Array.isArray(response)) {\n  if (response.length > 0) {\n    textId = response[0].id;\n  }\n}\n\nif (!textId) {\n  throw new Error('Keine Text-ID gefunden! Komplette Response war: ' + JSON.stringify(response));\n}\n\nreturn [{\n  json: {\n    basis: prev.basis,\n    category: prev.category,\n    number: prev.number,\n    name: prev.name,\n    new_offer_id: prev.new_offer_id,\n    text_id: textId,\n    token: prev.token,\n    edid: prev.edid\n  }\n}];"
