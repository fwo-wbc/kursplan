    {
      "parameters": {
        "jsCode": "const webhookItem = $input.first().json;\nlet body = webhookItem.body || webhookItem;\n\nif (typeof body === 'string') {\n  try { body = JSON.parse(body); } catch (e) { body = {}; }\n}\n\nlet kurse = (body && Array.isArray(body.kurse)) ? body.kurse : [];\nif (kurse.length === 0 && body && body.name) {\n  kurse = [body];\n}\n\nif (kurse.length === 0) {\n  throw new Error('Keine Kurse im Webhook-Body für den Status-Start-Batch gefunden.');\n}\n\n// kurs_key je Kurs sicherstellen (Format: datum|beginn|kursCode)\nconst batchKurse = kurse.map(k => {\n  const key = k.kurs_key || ((k.datum && k.beginn && k.kursCode)\n    ? (k.datum + '|' + k.beginn + '|' + k.kursCode)\n    : null);\n  return { kurs_key: key };\n});\n\nconst invalid = batchKurse.filter(k => !k.kurs_key);\nif (invalid.length > 0) {\n  throw new Error('Mindestens ein Kurs ohne kurs_key/datum/beginn/kursCode im Status-Start-Batch.');\n}\n\nreturn [{ json: { batchKurse } }];"
      },
      "id": "ef12a3b4-5678-4c9d-a1b2-3456c7d8e9f0",
      "name": "Kurse für Status-Batch aufbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
