      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// P05 - Kandidatenliste auswerten.\n// Kein Kandidat -> 'keine' (Workflow endet ueber NoOp sauber).\nconst kandidaten = $input.all();\nif (kandidaten.length === 0) {\n  return [{ json: { entscheidung: 'keine', anzahl: 0 } }];\n}\nreturn [{\n  json: {\n    entscheidung: 'vorhanden',\n    anzahl: kandidaten.length,\n    aelterster_run_id: kandidaten[0].json.run_id,\n  },\n}];"
        },
