        "id": "p05-0006-noop",
        "name": "P05 Keine Kandidaten",
        "type": "n8n-nodes-base.noOp",
        "typeVersion": 1,
        "position": [960, 220]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH kandidat AS (\n    SELECT s.run_id\n    FROM edoobox_raw.sync_run s\n    WHERE s.started_at >= (now() - INTERVAL '48 hours')\n      AND ( s.status = 'fehler'\n            OR (s.status = 'laeuft' AND s.started_at < (now() - INTERVAL '2 hours')) )\n      AND ( s.retry_status IS NULL OR s.retry_status = 'pending' )\n      AND s.retry_count < 3\n    ORDER BY s.started_at ASC\n    LIMIT 1\n    FOR UPDATE SKIP LOCKED\n)\nUPDATE edoobox_raw.sync_run s\nSET retry_status = 'in_progress',\n    retry_count  = s.retry_count + 1\nFROM kandidat k\nWHERE s.run_id = k.run_id\nRETURNING s.run_id, s.run_type, s.status, s.retry_count, s.retry_status, s.error_text;",
          "options": {}
        },
        "id": "p05-0007-markieren",
        "name": "P05 Kandidat markieren",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [960, -120],
        "credentials": {
          "postgres": {
            "id": "eXRRFRowW6RCTJvp",
            "name": "PostgreSQL Kursplan – n8n_writer"
          }
        }
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// P05 - Reichert den markierten Alt-Lauf um die Ziel-Workflow-IDs der Sync-Kette an.\n// Workflow-IDs (Stand PROJEKTSTAND §4.1); per Env P05_WORKFLOW_P0x_ID ueberschreibbar.\nconst run = $input.first().json;\nconst ziel = {\n  p01: $env.P05_WORKFLOW_P01_ID || 'eIyJaeTeqWidRYDu',\n  p02: $env.P05_WORKFLOW_P02_ID || 'IrS9JcdrOK1MXUO5',\n  p03: $env.P05_WORKFLOW_P03_ID || 'Rg3rB0RD8ISL0U6Y',\n};\nconst fehlend = ['p01', 'p02', 'p03'].filter((k) => !ziel[k]);\nreturn [{\n  json: {\n    ...run,\n    ...ziel,\n    konfig_ok: fehlend.length === 0,\n    konfig_fehler: fehlend.length ? 'Fehlende Ziel-Workflow-IDs in n8n: ' + fehlend.join(', ') : null,\n  },\n}];"
        },
        "id": "p05-0008-kontext",
        "name": "P05 Kontext bauen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1200, -120]
      },
      {
        "parameters": {
          "workflowId": "={{ $json.p01 }}",
          "workflowInputs": {
            "values": [
              {
                "name": "alt_run_id",
                "value": "={{ $json.run_id }}"
              }
            ]
          },
          "options": {}
        },
        "onError": "continueRegularOutput",
        "id": "p05-0009-p01",
        "name": "P05 P01 ausfuehren",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1,
        "position": [1440, -120]
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// P05 - Bewertet das Ergebnis des P01-Unterworkflow-Aufrufs.\nconst ctx = $('P05 Kontext bauen').first().json;\nconst out = $input.first().json;\nlet fehlertext = null;\nif (!out) {\n  fehlertext = 'Keine Ausgabe vom Unterworkflow P01';\n} else if (out.error) {\n  fehlertext = (typeof out.error === 'string') ? out.error : (out.error.message || JSON.stringify(out.error));\n} else if (out.json && out.json.error) {\n  fehlertext = (typeof out.json.error === 'string') ? out.json.error : JSON.stringify(out.json.error);\n}\nreturn [{ json: { run_id: ctx.run_id, stufe: 'P01', fehler: !!fehlertext, fehlertext: fehlertext || '' } }];"
        },
