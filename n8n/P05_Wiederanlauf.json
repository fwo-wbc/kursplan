      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT run_id, run_type, status, abgleichsart, retry_count, retry_status, error_text, started_at, finished_at\nFROM edoobox_raw.sync_run\nWHERE started_at >= (now() - INTERVAL '48 hours')\n  AND ( status = 'fehler'\n        OR (status = 'laeuft' AND started_at < (now() - INTERVAL '2 hours')) )\n  AND ( retry_status IS NULL OR retry_status = 'pending' )\n  AND retry_count < 3\nORDER BY started_at ASC;",
          "options": {}
        },
        "id": "p05-0003-suchen",
        "name": "P05 Kandidaten suchen",
