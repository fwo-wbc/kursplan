      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// P05 - Bereitet die Fehlerdaten fuer Status-Update (failed) und O-7-Eskalationsmail auf.\nconst d = $input.first().json;\nconst stufe = d.stufe || 'UNBEKANNT';\nconst fehlertext = d.fehlertext || 'Unbekannter Fehler im Wiederanlauf';\nconst mailBody = [\n  'Automatischer P05-Wiederanlauf fehlgeschlagen.',\n  '',\n  'Betroffener Alt-Lauf (run_id): ' + d.run_id,\n  'Fehlerstufe: ' + stufe,\n  'Fehlertext: ' + fehlertext,\n  '',\n  'Der Alt-Lauf wurde auf retry_status=failed gesetzt. Bitte manuell pruefen (O-7-Alarmschiene).',\n].join('\\n');\nreturn [{ json: { run_id: d.run_id, stufe: stufe, fehlertext: fehlertext, mail_body: mailBody } }];"
        },
        "id": "p05-0018-fehler",
        "name": "P05 Fehler behandeln",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [2160, 40]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE edoobox_raw.sync_run\nSET retry_status = 'failed',\n    error_text = left(coalesce(error_text, '') || E'\\n[P05] Wiederanlauf in ' || $2 || ' fehlgeschlagen: ' || $3, 4000)\nWHERE run_id = $1\nRETURNING run_id, retry_count, retry_status, error_text;",
          "options": {
            "queryReplacement": "={{ [$json.run_id, $json.stufe, $json.fehlertext] }}"
          }
        },
