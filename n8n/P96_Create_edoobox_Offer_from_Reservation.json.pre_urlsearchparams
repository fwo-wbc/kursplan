            "id": "p96-0003-token-normalisieren",
            "name": "P96 Token normalisieren",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                680,
                300
            ],
            "parameters": {
                "jsCode": "// Token aus beiden edoobox-Antwortformen ermitteln (analog P90).\nconst auth = $input.first().json;\nconst token = typeof auth.data === 'string' ? auth.data : auth.access_token;\nconst edid = auth.edid ?? auth?.data?.edid;\nif (!token) {\n  throw new Error('Kein Token in der edoobox-Auth-Antwort enthalten.');\n}\nconst webhook = $('P96 Webhook').first().json;\n// Der Webhook-Node legt den Request-Body unter 'body' ab. Die Payload-Felder\n// (kdnr, firmenname, kursnr, start, ende, ...) werden deshalb flach uebernommen,\n// damit die Folgeknoten sie direkt lesen koennen.\nconst payload = webhook.body || {};\nconst basis = payload.basis_url || auth.basis_url || 'https://app1.edoobox.com';\nreturn [{ json: { ...payload, token, edid, basis } }];"
            }
        },
        {
            "id": "p96-0004-kategorien",
            "name": "P96 Kategorien verarbeiten",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                900,
                300
            ],
            "parameters": {
                "jsCode": "// Kategorie-Handling:\n//  1) Falls im Payload eine category_id uebergeben wurde: pruefen, ob sie in\n//     edoobox existiert (GET /v2/category/{category_id}).\n//  2) Existiert sie (HTTP 200): diese ID verwenden.\n//  3) Existiert sie nicht (HTTP 404 oder Fehler):\n//     a) Hauptkategorie 'Firmenkurse' ueber GET /v2/category/list suchen\n//        (List-Endpunkt gemaess P90: '/category/list', Paginierung limit[start/reply]).\n//     b) Unterkategorie '[kdnr] [Firmenname]' suchen, sonst unter 'Firmenkurse' anlegen.\n//        GET listet die Elternkennung im Feld 'parent'; das ANLEGEN erwartet sie im\n//        Feld 'category' (API-Hinweis ED80100: require { name, category, type }).\nconst state = $('P96 Token normalisieren').first().json;\nconst headers = {\n  'Authorization': `Bearer ${state.token}`,\n  'Content-Type': 'application/json',\n  'grant-type': 'access_token',\n  ...(state.edid ? { edid: state.edid } : {})\n};\n\nfunction rowsAus(roh) {\n  const d = roh && roh.data ? roh.data : roh;\n  if (Array.isArray(d)) return d;\n  if (d && typeof d === 'object') return Object.values(d);\n  return [];\n}\n\n// 1) Uebergebene category_id pruefen (GET /v2/category/{category_id})\nlet categoryId = state.category_id ? String(state.category_id) : null;\nif (categoryId) {\n  const pruef = await this.helpers.httpRequest({\n    method: 'GET',\n    url: `${state.basis}/v2/category/${encodeURIComponent(categoryId)}`,\n    headers,\n    json: true,\n    returnFullResponse: true,\n    timeout: 120000,\n    ignoreHttpStatusErrors: true,\n  });\n\n  if (pruef.statusCode >= 200 && pruef.statusCode < 300) {\n    // 2) Kategorie existiert -> uebergebene ID verwenden\n    categoryId = String(categoryId);\n  } else {\n    // 3) HTTP 404 oder Fehler -> Kategorie neu ermitteln bzw. anlegen\n    categoryId = null;\n  }\n}\n\nif (!categoryId) {\n  // 3a) Hauptkategorie 'Firmenkurse' ueber GET /v2/category/list suchen\n  const listen = await this.helpers.httpRequest({\n    method: 'GET',\n    url: `${state.basis}/v2/category/list`,\n    headers,\n    qs: { 'limit[start]': 0, 'limit[reply]': 2000 },\n    json: true,\n    returnFullResponse: true,\n    timeout: 120000,\n    ignoreHttpStatusErrors: true,\n  });\n\n  if (!(listen.statusCode >= 200 && listen.statusCode < 300)) {\n    throw new Error('GET /v2/category/list: HTTP ' + listen.statusCode + ' - ' + JSON.stringify(listen.body).slice(0, 800));\n  }\n\n  const kategorien = rowsAus(listen.body);\n  const haupt = kategorien.find((c) => (c.name || c.title) === 'Firmenkurse');\n  if (!haupt) {\n    throw new Error('Hauptkategorie Firmenkurse wurde nicht gefunden.');\n  }\n  const hauptId = haupt.id ?? haupt.category_id ?? haupt.ref;\n\n  // 3b) Unterkategorie '[kdnr] [Firmenname]' suchen\n  const unterName = `${state.kdnr} ${state.firmenname}`;\n  const unter = kategorien.find((c) => (c.name || c.title) === unterName);\n  categoryId = unter ? String(unter.id ?? unter.category_id ?? unter.ref) : null;\n\n  // 3c) Nicht gefunden -> unter 'Firmenkurse' neu anlegen\n  if (!categoryId) {\n    const angelegt = await this.helpers.httpRequest({\n      method: 'POST',\n      url: `${state.basis}/v2/category`,\n      headers,\n      body: { data: { name: unterName, category: hauptId, type: 'folder' } },\n      json: true,\n      returnFullResponse: true,\n      timeout: 120000,\n      ignoreHttpStatusErrors: true,\n    });\n\n    if (!(angelegt.statusCode >= 200 && angelegt.statusCode < 300)) {\n      throw new Error('POST /v2/category: HTTP ' + angelegt.statusCode + ' - ' + JSON.stringify(angelegt.body).slice(0, 800));\n    }\n\n    const ak = angelegt.body || {};\n    if (ak.data && typeof ak.data === 'object') {\n      categoryId = ak.data.id ?? ak.data.category_id ?? ak.data.ref;\n    } else if (typeof ak.data === 'string' || typeof ak.data === 'number') {\n      categoryId = ak.data;\n    } else if (ak.category && typeof ak.category === 'object') {\n      categoryId = ak.category.id ?? ak.category.category_id ?? ak.category.ref;\n    } else {\n      categoryId = ak.id ?? ak.category_id ?? ak.ref;\n    }\n    if (categoryId !== null && categoryId !== undefined) {\n      categoryId = String(categoryId);\n    }\n  }\n}\n\nif (!categoryId) {\n  throw new Error('Unterkategorie konnte nicht ermittelt oder angelegt werden.');\n}\n\nreturn [{ json: { ...state, category_id: String(categoryId) } }];"
            }
